---
import '../styles/global.css';
import '../styles/home.css';

import Layout from '../layouts/Layout.astro';
import Background from '../layouts/Background.jsx';
import Navbar from '../components/Navbar.jsx';
import Hero from '../components/Hero.jsx';
import About from '../components/About.jsx';
import Portfolio from '../components/Portfolio.jsx';
---

<Layout title="Portofolio Saya">

    <Background client:only="react" />

    <header class="nav-wrap">
        <Navbar client:load />
    </header>

    <main>
        <section id="home" class="Home">
            <Hero client:only="react" />
        </section>

        <section id="about" class="section-container">
              <About client:only="react" />
        </section>

        <section id="portfolio" class="section-container">
            <div class="section-header">
                <h2>Portfolio</h2>
                <p>Project experience and software development work that I have built.</p>
            </div>
            <Portfolio client:visible />
        </section>

    </main>

</Layout>
